{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-preview/types/**/*.ts",
    ".next-preview/dev/types/**/*.ts",
    ".next-voice/types/**/*.ts",
    ".next-voice/dev/types/**/*.ts",
    ".next-voice2/types/**/*.ts",
    ".next-voice2/dev/types/**/*.ts",
    ".next-voice3/types/**/*.ts",
    ".next-voice3/dev/types/**/*.ts",
    ".next-voice4/types/**/*.ts",
    ".next-voice4/dev/types/**/*.ts",
    ".next-voice5/types/**/*.ts",
    ".next-voice5/dev/types/**/*.ts",
    ".next-clean/types/**/*.ts",
    ".next-clean/dev/types/**/*.ts",
    ".next-ai/types/**/*.ts",
    ".next-ai/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

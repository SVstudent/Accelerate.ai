# Accelerate.ai — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored and must never be
# committed: every value below that is marked SECRET is a live credential.

# ── Neon (agent backend: missions, facts, runs, evaluations) ─────────────
DATABASE_URL=                  # SECRET · pooled connection string
DATABASE_URL_UNPOOLED=         # SECRET · direct connection, for migrations
DATABASE_URL_DEMO=             # SECRET · frozen demo branch, replay only
NEON_BRANCH=main
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# ── Tiger Data / TimescaleDB (training telemetry) ────────────────────────
TIGER_DATABASE_URL=            # SECRET

# ── Bright Data (web ground truth) ───────────────────────────────────────
BRIGHTDATA_API_TOKEN=          # SECRET
BRIGHTDATA_CUSTOMER_ID=        # SECRET
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
BRIGHTDATA_BROWSER_ZONE=
BRIGHTDATA_MAX_REQUESTS_PER_MISSION=120

# ── Vultr Serverless Inference (reward + env authoring) ──────────────────
VULTR_INFERENCE_API_KEY=       # SECRET
VULTR_MODEL=
VULTR_MODEL_FALLBACK=
LLM_TIMEOUT_MS=60000

# ── Vision QA (image verification) ───────────────────────────────────────
VISION_PROVIDER=tokenrouter
GEMINI_API_KEY=                # SECRET · only if VISION_PROVIDER=gemini
GEMINI_MODEL=
TOKENROUTER_API_KEY=           # SECRET
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_VISION_MODEL=
TOKENROUTER_VISION_FALLBACK=
VISION_CONCURRENCY=32
VISION_MAX_PX=320
CURATOR_MAX_PER_CLASS=70

# ── Daytona (ephemeral training sandboxes) ───────────────────────────────
DAYTONA_API_KEY=               # SECRET
DAYTONA_API_URL=
DAYTONA_SNAPSHOT=
SANDBOX_MODE=daytona
MAX_PARALLEL_SANDBOXES=6
FARM_PRESET=

# ── Demo / runtime ───────────────────────────────────────────────────────
DEMO_MISSION_ID=               # mission the Observatory pins for replay
DEMO_MODE=true                 # auto-confirm the task spec for unattended runs

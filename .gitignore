# ── secrets & local config ───────────────────────────────────────────────
# Never commit these. Real credentials live only on the machine that runs
# the mission; .env.example documents the shape without the values.
.env
.env.*
!.env.example
.neon
.vercel
*.pem
*.key
secrets.json
credentials.json

# ── dependencies & virtualenvs ───────────────────────────────────────────
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── build output ─────────────────────────────────────────────────────────
.next/
.next-*/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── generated media & scratch ────────────────────────────────────────────
.voice-verify/
*.mp3
*.wav
*.aiff
*.zip

# ── logs & local databases ───────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.sqlite
*.sqlite3
*.db

# ── OS / editor ──────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
Thumbs.db

# ── coverage ─────────────────────────────────────────────────────────────
/coverage
